# Base directories to scan for protein binder design runs
RUN_BASE_DIRS="./example_runs"

# SQLite (default) or Postgres URL for ingested runs and design metadata (tag, good).
# If unset, the server uses backend/data/binderdash.sqlite (see default in backend/main.py).
# After "sqlite:", the URL uses three slashes for a path relative to the process cwd, or
# four slashes before an absolute path (e.g. sqlite:////app/data/binderdash.sqlite). Using
# sqlite:///app/db.sqlite is parsed as relative "app/db.sqlite" → /app/app/db.sqlite in Docker.
# Docker Compose mounts ./data → /app/data; keep DATABASE under that path.
# Examples:
#   Relative path:
#   DATABASE="sqlite:///data/binderdash.sqlite"
#   Absolute path:
#   DATABASE="sqlite:////app/data/db.sqlite"
#   PostgreSQL:
#   DATABASE="postgresql://user:pass@localhost:5432/binderdash"
# DATABASE=
DATABASE="sqlite:///data/binderdash.sqlite"

# Logging: INFO (default) or DEBUG for phase timings (grep logs for " timing ")
# LOG_LEVEL=DEBUG

# Disable authentication (set to 'true' to disable all authentication)
# When disabled, all endpoints become public
DISABLE_AUTHENTICATION="true"

# --- Local bcrypt users (optional; enabled when LOCAL_USERS is non-empty)
# POST /api/auth/login checks these first (bcrypt verify), then PAM if PAM_LOCAL_ENABLED is true.
# Format: "username:bcrypt_hash,username2:bcrypt_hash2"
# Generate hashes with: python backend/scripts/encrypt_password.py username
#LOCAL_USERS="alice:$2b$12$...,bob:$2b$12$..."

# --- PAM (Unix) password authentication
# Requires libpam (e.g. libpam-modules on Debian). Checked only if LOCAL_USERS does not match.
# Docker: the image usually only has the `app` user in /etc/passwd — host logins like your
# desktop user do not exist unless you add them (e.g. useradd), use LOCAL_USERS, or bind-mount
# the host's /etc/passwd, /etc/group, and /etc/shadow read-only (see commented volumes in
# docker-compose.yml — exposes host account database to the container; trusted hosts only).
PAM_LOCAL_ENABLED="false"
# Comma-separated Unix usernames (case-insensitive match), or * for any user who passes PAM.
# PAM_LOCAL_ALLOWED_USERS="ubuntu"
# PAM stack name (file under /etc/pam.d/). Use common-auth for password checks (Debian/Ubuntu;
# works better in containers than "login", which is often tied to TTY/session).
# PAM_LOCAL_SERVICE="common-auth"

# --- Google OAuth 2.0 (OIDC)
GOOGLE_AUTH_ENABLED="true"
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web application)
GOOGLE_AUTH_CLIENT_ID=""
GOOGLE_AUTH_CLIENT_SECRET=""
# Must match an "Authorised redirect URI" in the Google client (e.g. https://your.host/api/auth/google/callback)
GOOGLE_AUTH_REDIRECT_URI="http://localhost:8000/api/auth/google/callback"
# Comma-separated emails (case-insensitive). Empty list denies all Google sign-ins when OAuth is enabled.
GOOGLE_AUTH_ALLOWED_USERS=""

# JWT secret key (auto-generated if not provided; use a fixed value in production)
# SECRET_KEY="your-secret-key-here"

# CORS allowed origins (comma-separated list of allowed origins)
# Defaults to "*" (allow all origins) if not set
# For production with Caddy, set to your domain:
#   CORS_ALLOWED_ORIGINS="https://binderdash.example.com"
# For development:
#   CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
# CORS_ALLOWED_ORIGINS=""

# Domain for production deployment (used by Caddy for automatic HTTPS)
# Example: DOMAIN="binderdash.example.com"
# DOMAIN=""

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API base URL for frontend development (used by Vite proxy)
# Defaults to http://localhost:8000 if not set
# API_BASE="http://localhost:8000"
